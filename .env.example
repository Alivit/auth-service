AUTH_SERVICE_PORT=8082
AUTH_SERVICE_NAME=auth-service
AUTH_GRPC_SERVER_PORT=9090

AUTH_POSTGRES_PORT=5433
AUTH_DB_ROOT_USER=DB_ROOT_USER
AUTH_DB_ROOT_PASSWORD=DB_ROOT_PASSWORD
AUTH_DB_NAME=DB_NAME
AUTH_DB_USERNAME=DB_USERNAME
AUTH_DB_PASSWORD=DB_PASSWORD
AUTH_DB_SCHEMA=DB_SCHEMA

KC_ADMIN_USER=ADMIN_USER
KC_ADMIN_PASSWORD=ADMIN_PASSWORD
KC_DB=postgres
KC_HTTPS_PORT=8443
KC_TRANSACTION_XA_ENABLED=false
KC_HOSTNAME_STRICT=false
KC_FEATURES=http-optimized-serializers
KC_HTTPS_CERTIFICATE_FILE=/opt/keycloak/conf/keycloak.crt
KC_HTTPS_CERTIFICATE_KEY_FILE=/opt/keycloak/conf/keycloak.key
KC_TRUSTSTORE_PATHS=/opt/keycloak/conf/root-ca.crt

APP_REALM=REALM
APP_CLIENT_ID=CLIENT_ID
APP_SECURITY_TOKEN_LIFESPAN=TOKEN_LIFESPAN

APP_ADMIN_USERNAME=ADMIN_USERNAME
APP_ADMIN_EMAIL=ADMIN_EMAIL
APP_ADMIN_PASSWORD=ADMIN_PASSWORD