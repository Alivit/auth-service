{
  "id": "dev",
  "realm": "dev",
  "enabled": true,
  "rememberMe": true,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "maxFailureWaitSeconds": 900,
  "permanentLockout": false,
  "maxDeltaTimeSeconds": 43200,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 300,
  "ssoSessionIdleTimeout": 604800,
  "ssoSessionMaxLifespan": 2592000,
  "defaultSignatureAlgorithm": "ES256",
  "passwordPolicy": "length(12) and digits(1) and upperCase(1) and lowerCase(1) and specialChars(1) and notUsername(true)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 3,
  "otpPolicyPeriod": 30,
  "browserFlow": "browser-conditional-mfa",
  "directGrantFlow": "direct-grant-conditional-mfa",
  "defaultRoles": [
    "ROLE_USER"
  ],
  "roles": {
    "realm": [
      {
        "name": "ROLE_USER",
        "description": "User Role",
        "composite": false
      },
      {
        "name": "ROLE_ADMIN",
        "description": "Administrator Role",
        "composite": false
      },
      {
        "name": "ROLE_INTERNAL_SERVICE",
        "description": "Role for internal backend microservices",
        "composite": false
      }
    ]
  },
  "groups": [
    {
      "name": "realm-administrators",
      "path": "/realm-administrators",
      "attributes": {},
      "realmRoles": [
        "ROLE_ADMIN"
      ],
      "clientRoles": {
        "realm-management": [
          "realm-admin"
        ]
      },
      "subGroups": []
    }
  ],
  "clients": [
    {
      "clientId": "test-auth-client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "clientAuthenticatorType": "client-x509",
      "attributes": {
        "x509.subjectdn": "CN=auth-service"
      },
      "redirectUris": [
        "http://localhost:8082/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "+"
      ],
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "client-audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "test-auth-client",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-auth-client",
      "enabled": true,
      "serviceAccountClientId": "test-auth-client",
      "realmRoles": [
        "ROLE_INTERNAL_SERVICE"
      ],
      "clientRoles": {
        "realm-management": [
          "manage-users"
        ]
      }
    },
    {
      "username": "TestAdmin",
      "enabled": true,
      "email": "testadmin@company.com",
      "emailVerified": true,
      "groups": [
        "/realm-administrators"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "TestPassword123.",
          "temporary": false
        },
        {
          "type": "otp",
          "userLabel": "Automated Test Device",
          "secretData": "{\"value\":\"GEZDGNBVGY3TQOJQ\"}",
          "credentialData": "{\"subType\":\"totp\",\"digits\":6,\"period\":30,\"algorithm\":\"HmacSHA1\"}"
        }
      ]
    },
    {
      "username": "TestAdminTwo",
      "enabled": true,
      "email": "testadmintwo@company.com",
      "emailVerified": true,
      "groups": [
        "/realm-administrators"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "TestPassword123.",
          "temporary": false
        },
        {
          "type": "otp",
          "userLabel": "Automated Test Device",
          "secretData": "{\"value\":\"GEZDGNBVGY3TQOJQ\"}",
          "credentialData": "{\"subType\":\"totp\",\"digits\":6,\"period\":30,\"algorithm\":\"HmacSHA1\"}"
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "check-admin-role-config",
      "config": {
        "condUserRole": "ROLE_ADMIN"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "browser-conditional-mfa",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "browser-forms-subflow",
          "requirement": "ALTERNATIVE",
          "priority": 20
        }
      ]
    },
    {
      "alias": "browser-forms-subflow",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "conditional-otp-subflow",
          "requirement": "CONDITIONAL",
          "priority": 20
        }
      ]
    },
    {
      "alias": "conditional-otp-subflow",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorConfig": "check-admin-role-config"
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20
        }
      ]
    },
    {
      "alias": "direct-grant-conditional-mfa",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "direct-grant-validate-username",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticator": "direct-grant-validate-password",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "direct-grant-conditional-otp-subflow",
          "requirement": "CONDITIONAL",
          "priority": 30
        }
      ]
    },
    {
      "alias": "direct-grant-conditional-otp-subflow",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorConfig": "check-admin-role-config"
        },
        {
          "authenticator": "direct-grant-validate-otp",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20
        }
      ]
    }
  ],
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure TOTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30
    },
    {
      "alias": "UPDATE_PROFILE",
      "name": "Update Profile",
      "providerId": "UPDATE_PROFILE",
      "enabled": true,
      "defaultAction": false,
      "priority": 40
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": false,
      "defaultAction": false,
      "priority": 50
    }
  ]
}